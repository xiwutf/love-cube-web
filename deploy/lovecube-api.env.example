# 复制为服务器上的 /opt/lovecube-api/lovecube-api.env 后填入真实值。
# 不要把真实密钥提交进 Git。由 install-infra 的 write_env_file 调用 write-env.sh 合并生成。
# systemd EnvironmentFile 语法：KEY=value，不要写 export。
#
# write-env.sh 规则：GitHub Secret 非空才覆盖；为空则保留服务器上已有值。

SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
JWT_SECRET=
APP_BASE_URL=
WECHAT_APPID=
WECHAT_SECRET=

OSS_ENABLED=true
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
OSS_BUCKET_NAME=
OSS_CDN_DOMAIN=

MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
NOTIFICATION_MAIL_ENABLED=false

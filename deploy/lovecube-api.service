[Unit]
Description=Love Cube API (Spring Boot)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# uploads/ 与 logs/love-cube.log 都相对 user.dir，必须固定在当前项目目录，禁止依赖 /root
WorkingDirectory=/opt/lovecube-api
EnvironmentFile=-/opt/lovecube-api/lovecube-api.env
ExecStart=@@JAVA_BIN@@ -jar /opt/lovecube-api/lovecube-api.jar --spring.config.location=file:/opt/lovecube-api/application.yml --spring.flyway.baseline-on-migrate=true --spring.flyway.baseline-version=13
Restart=always
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5
TimeoutStartSec=120
TimeoutStopSec=30
KillSignal=SIGTERM
SuccessExitStatus=143
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lovecube-api

[Install]
WantedBy=multi-user.target

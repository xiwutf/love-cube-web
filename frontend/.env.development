# 本地开发固定端口（与 vite strictPort 配合，避免自动跳到 5174）
VITE_DEV_PORT=5173

# 开发环境：通过 Vite 代理访问后端（相对路径，由 vite.config.js 的 proxy 转发）
VITE_API_BASE_URL=/admin

# 后端服务地址（仅供 Vite proxy 使用，不注入浏览器）
# 本机未启动 Spring Boot 时不要写 localhost:8090，否则登录等接口会被代理成 500
VITE_BACKEND_ORIGIN=https://lovecube.xifg.com.cn

# 邀请二维码必须使用公网域名，避免保存转发后出现 localhost / 局域网 IP
VITE_INVITE_BASE_URL=https://lovecube.xifg.com.cn
